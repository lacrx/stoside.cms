# Strapi production environment variables.
# Copy to .env.production and fill in real values.
# Run: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ─── Server ───
HOST=0.0.0.0
PORT=1337

# ─── Strapi secrets (generate unique random values for each) ───
APP_KEYS=generate-random-key-1,generate-random-key-2
ADMIN_JWT_SECRET=generate-random-secret
API_TOKEN_SALT=generate-random-salt
ENCRYPTION_KEY=generate-random-key
TRANSFER_TOKEN_SALT=generate-random-salt
JWT_SECRET=generate-random-secret

# ─── Database (SQLite, stored in /app/.tmp/data.db via Docker volume) ───
DATABASE_CLIENT=sqlite

# ─── AWS S3 media uploads ───
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-media-bucket-name-from-cloudformation-output
MEDIA_URL=https://media.stoside.org
