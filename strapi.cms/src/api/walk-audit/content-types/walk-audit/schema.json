{
  "kind": "collectionType",
  "collectionName": "walk_audits",
  "info": {
    "singularName": "walk-audit",
    "pluralName": "walk-audits",
    "displayName": "Walk Audit"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "active", "completed"],
      "default": "draft",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "mapUrl": {
      "type": "string"
    },
    "segments": {
      "type": "component",
      "repeatable": true,
      "component": "walk-audit.segment"
    }
  }
}
